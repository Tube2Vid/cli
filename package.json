{
  "name": "@tube2vid/cli",
  "version": "1.0.0",
  "description": "The tube2vid command: download video, audio and images from YouTube, TikTok, Instagram and 1,800+ sites through the Tube2Vid API.",
  "license": "MIT",
  "homepage": "https://tube2vid.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tube2Vid/cli.git"
  },
  "bugs": {
    "url": "https://github.com/Tube2Vid/cli/issues"
  },
  "keywords": [
    "tube2vid",
    "cli",
    "command line",
    "youtube downloader",
    "tiktok downloader",
    "instagram downloader",
    "video downloader",
    "mp3 downloader",
    "yt-dlp alternative",
    "media download"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "tube2vid": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tube2vid/sdk": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "author": "Tube2Vid (https://tube2vid.com)",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
